:root {
    --bg-dark: #000000;
    --bg-card: rgba(18, 18, 21, 0.7);
    --glass-bg: rgba(9, 9, 11, 0.7);
    --glass-border: rgba(255, 255, 255, 0.08);
    --text-white: #FFFFFF;
    --text-gray: #A1A1AA;
    --accent-purple: #7eb3e3;
    --accent-cyan: #22d3ee;
    --amaru-gold: #fbbf24;
    --danger: #ef4444;
    --success: #22c55e;
    --font-main: 'Inter', sans-serif;
    --accent-purple-glow: rgba(126, 179, 227, 0.15);
    --accent-cyan-glow: rgba(34, 211, 238, 0.1);
    --accent-primary: #FFFFFF;
    --nav-height: 70px;
    --font-heading: 'Plus Jakarta Sans', sans-serif;
    --font-body: 'Inter', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
    -webkit-tap-highlight-color: transparent;
}

h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: var(--font-heading);
}

body {
    background-color: var(--bg-dark);
    color: var(--text-white);
    overflow: hidden;
    height: 100vh;
    width: 100vw;
}

#app-container {
    height: 100%;
    display: flex;
    flex-direction: column;
}

#main-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    padding-bottom: calc(var(--nav-height) + 20px);
}

.screen {
    display: none;
}

.screen.active {
    display: block;
}

.hidden {
    display: none !important;
}

/* Dashboard Sections */
.glass {
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 20px;
    margin-bottom: 20px;
}

.glass-premium {
    background: linear-gradient(135deg, rgba(215, 245, 244, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(30px);
    border: 1px solid rgba(215, 245, 244, 0.3);
    border-radius: 32px;
    padding: 25px;
    margin-bottom: 25px;
}

/* Auth Screens */
.auth-container {
    padding: 40px 25px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: radial-gradient(circle at bottom left, var(--accent-cyan-glow), transparent);
}

.auth-header {
    text-align: center;
    margin-bottom: 40px;
}

.auth-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 8px;
}

.auth-header p {
    color: var(--text-gray);
    font-size: 0.9rem;
}

.auth-form-group {
    margin-bottom: 20px;
}

.auth-form-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-gray);
    margin-bottom: 8px;
    margin-left: 4px;
}

.auth-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.auth-input-wrapper i {
    position: absolute;
    left: 16px;
    color: var(--text-gray);
    width: 18px;
}

.auth-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    padding: 14px 14px 14px 48px;
    border-radius: 16px;
    color: white;
    font-size: 0.95rem;
    transition: 0.3s;
}

.auth-input:focus {
    outline: none;
    border-color: var(--accent-purple);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 15px var(--accent-purple-glow);
}

.auth-btn {
    width: 100%;
    padding: 16px;
    border-radius: 50px;
    border: none;
    background: var(--accent-primary);
    color: var(--bg-dark);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    margin-top: 10px;
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
    transition: 0.3s;
}

.auth-btn:active {
    scale: 0.98;
}

.google-btn {
    background: white !important;
    color: #1f2937 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
}

.google-btn img {
    width: 20px;
    height: 20px;
}

.auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 20px 0;
    color: var(--text-gray);
    font-size: 0.8rem;
    font-weight: 600;
}

.auth-divider::before,
.auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--glass-border);
}

.auth-divider:not(:empty)::before {
    margin-right: .75em;
}

.auth-divider:not(:empty)::after {
    margin-left: .75em;
}


.form-toggle {
    text-align: center;
    margin-top: 30px;
    font-size: 0.85rem;
    color: var(--text-gray);
}

.form-toggle span {
    color: var(--accent-cyan);
    font-weight: 700;
    cursor: pointer;
    margin-left: 5px;
}


/* Dashboard Layout & Progress Ring */
.stats-grid {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 24px;
}

.hero-card {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    height: 200px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    border: 1px solid var(--glass-border);
}

.hero-img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
}

.card-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.9) 0%, rgba(8, 8, 10, 0.4) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 3;
    padding: 30px;
    width: 100%;
}

.hero-content h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 8px 0;
}

.hero-content p {
    font-size: 0.85rem;
    color: var(--text-gray);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 15px;
}

.btn-glass {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    padding: 10px 20px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
}

.stat-card {
    min-width: 160px;
    flex: 1;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.progress-ring-container {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 12px;
}

.progress-ring__circle {
    transition: stroke-dashoffset 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    filter: drop-shadow(0 0 8px var(--accent-purple-glow));
}

.progress-value {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
}

.stat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-gray);
    letter-spacing: 0.5px;
}

.pulse-update {
    animation: ringPulse 0.4s ease-out;
}

@keyframes ringPulse {
    0% {
        filter: drop-shadow(0 0 8px var(--accent-purple-glow));
    }

    50% {
        filter: drop-shadow(0 0 20px var(--accent-purple));
        transform: scale(1.05) rotate(-90deg);
    }

    100% {
        filter: drop-shadow(0 0 8px var(--accent-purple-glow));
    }
}

/* NEW: Premium Headers */
.section-header-premium {
    margin-bottom: 30px;
}

.section-header-premium h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 5px;
    background: linear-gradient(90deg, #fff, var(--text-gray));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitle {
    font-size: 0.8rem;
    color: var(--text-gray);
}

.header-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* NEW: Agenda / Date Chips */
.date-carousel-premium {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 15px 0;
    scrollbar-width: none;
}

.date-chip {
    min-width: 60px;
    height: 85px;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: 0.3s;
    cursor: pointer;
}

.date-chip span {
    font-size: 0.65rem;
    color: var(--text-gray);
    font-weight: 700;
    margin-bottom: 5px;
}

.date-chip p {
    font-size: 1.2rem;
    font-weight: 800;
}

.date-chip.active {
    background: white;
    border-color: white;
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
    scale: 1.05;
}

.date-chip.active span,
.date-chip.active p {
    color: black !important;
}

/* NEW: Class Selection Visuals */
.filters-premium {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    overflow-x: auto;
    scrollbar-width: none;
}

.filter-tag {
    padding: 8px 18px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    background: var(--bg-card);
    color: var(--text-grey);
    font-size: 0.75rem;
    font-weight: 700;
}

.filter-tag.active {
    background: var(--accent-primary);
    color: var(--bg-dark);
    border-color: var(--accent-primary);
}

.class-timeline {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.stitch-class-card {
    position: relative;
    height: 140px;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    display: flex;
    align-items: flex-end;
}

.stitch-class-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
}

/* Dark Elegant Gradient for Class Cards */
.smoke-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.88) 100%);
    z-index: 2;
    transition: 0.3s;
}

.stitch-class-card:hover .smoke-layer {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 1) 100%);
}

.cls-info-main h4 {
    color: #FFFFFF !important;
    font-weight: 800;
    font-size: 1.15rem;
    margin-bottom: 4px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.cls-info-main p {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600;
    font-size: 0.8rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.cls-info-main .tag {
    background: rgba(203, 242, 240, 0.15) !important;
    color: #CBF2F0 !important;
    border: 1px solid rgba(203, 242, 240, 0.3);
    backdrop-filter: blur(4px);
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
}

.stitch-class-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(203, 242, 240, 0.1) 0%, transparent 60%);
    z-index: 1;
    pointer-events: none;
}

.admin-collapsible-module {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 20px;
}

.module-header {
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: background 0.2s ease;
}

.module-header:hover {
    background: rgba(255, 255, 255, 0.05);
}

.module-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
}

.module-content {
    padding: 0 22px 22px 22px;
    max-height: 2000px;
    transition: max-height 0.3s ease-in-out, padding 0.3s ease;
}

.module-content.collapsed {
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    pointer-events: none;
    opacity: 0;
}

.export-controls-container {
    display: flex;
    gap: 8px;
    align-items: center;
    background: rgba(0, 0, 0, 0.2);
    padding: 6px;
    border-radius: 10px;
    border: 1px solid var(--glass-border);
}

.export-select-minimal {
    background: transparent;
    color: var(--text-gray);
    border: none;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 5px;
    outline: none;
    cursor: pointer;
}

.export-select-minimal option {
    background: var(--bg-dark);
    color: white;
}

.btn-export-minimal {
    background: var(--accent-purple);
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: transform 0.2s;
}

.btn-export-minimal:active {
    transform: scale(0.95);
}

.smoke-purple {
    background: radial-gradient(circle at top right, rgba(126, 179, 227, 0.1), transparent),
                radial-gradient(circle at bottom left, rgba(126, 179, 227, 0.03), transparent);
}

.payment-card-mini {
    padding: 12px;
    border-radius: 12px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.payment-card-mini.pending {
    border-left: 4px solid var(--amaru-gold);
}

.payment-card-mini.paid {
    border-left: 4px solid var(--success);
}

.stitch-class-content {
    position: relative;
    z-index: 3;
    padding: 15px 20px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.cls-info-main h4 {
    font-size: 1.1rem;
    font-weight: 800;
}

.cls-info-main p {
    font-size: 0.75rem;
    color: var(--text-gray);
    margin-top: 2px;
}

.btn-reserve-stitch {
    background: var(--accent-primary);
    border: none;
    color: var(--bg-dark);
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.75rem;
    cursor: pointer;
    transition: 0.3s;
}

.btn-reserve-stitch.active {
    background: #10b981;
}

.btn-reserve-stitch:disabled {
    background: #334155;
    cursor: not-allowed;
    opacity: 0.6;
}

.booking-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--glass-border);
    /* Changed from --accent-purple to match existing design language */
    border-radius: 18px;
    /* Added for consistency with other elements */
    padding: 15px 20px;
    /* Added padding */
    margin-bottom: 25px;
}

.status-text strong {
    display: block;
    color: var(--accent-cyan);
    font-size: 1.1rem;
    margin-bottom: 4px;
}

.status-text p {
    font-size: 0.8rem;
    color: var(--text-gray);
}

.stitch-class-card.booked {
    border-color: #10b981;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
}

/* NEW: Premium Tournaments */
.tournament-selector {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
}

.sel-tab {
    flex: 1;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-gray);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1px;
}

.sel-tab.active {
    background: white;
    color: black;
    border-color: white;
}

.premium-tourney-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

.stitch-tourney-card {
    height: 160px;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--glass-border);
}

.st-tourney-img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.st-tourney-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(215, 245, 244, 0.6) 0%, rgba(8, 8, 10, 0.9) 100%);
}

.st-tourney-content {
    position: relative;
    z-index: 3;
    padding: 20px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.st-tag {
    background: rgba(0, 0, 0, 0.5);
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.6rem;
    font-weight: 700;
    width: fit-content;
}

.st-title-group h4 {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 4px;
}

.st-title-group p {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    gap: 5px;
}

/* NEW: Action Glow Buttons */
.btn-action-glow {
    width: 45px;
    height: 45px;
    border-radius: 15px;
    background: var(--accent-purple);
    border: none;
    color: white;
    cursor: pointer;
    box-shadow: 0 0 15px var(--accent-purple-glow);
}

/* Luxury Avatar Redesign */
.avatar-container-luxury {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 30px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.avatar-outer-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 38% 62% 63% 37% / 41% 44% 56% 59%;
    /* Organic fluid shape */
    background: linear-gradient(45deg, var(--accent-purple), var(--accent-cyan));
    filter: blur(15px);
    opacity: 0.5;
    animation: liquidMorph 8s ease-in-out infinite;
}

@keyframes liquidMorph {

    0%,
    100% {
        border-radius: 38% 62% 63% 37% / 41% 44% 56% 59%;
        transform: rotate(0deg);
    }

    50% {
        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        transform: rotate(180deg);
    }
}

.avatar-inner-frame {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 28px;
    /* Modern "Squircle" */
    padding: 4px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.avatar-image-premium {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
}

.avatar-glare {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(45deg);
    animation: glareSwipe 4s linear infinite;
    pointer-events: none;
}

@keyframes glareSwipe {
    0% {
        transform: translate(-30%, -30%) rotate(45deg);
    }

    100% {
        transform: translate(30%, 30%) rotate(45deg);
    }
}

.avatar-actions-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    opacity: 0;
    transition: 0.3s;
    z-index: 10;
}

.avatar-inner-frame:hover .avatar-actions-overlay {
    opacity: 1;
}

.avatar-actions-overlay button {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
    transition: 0.2s;
}

.avatar-actions-overlay button:hover {
    background: var(--accent-purple);
    transform: scale(1.1);
}

.avatar-actions-overlay button.delete:hover {
    background: #ef4444;
}

.avatar-actions-overlay button i {
    width: 16px;
    height: 16px;
}


.rank-badge {
    position: absolute;
    bottom: -15px;
    background: linear-gradient(135deg, #FFD700, #B8860B);
    color: #000;
    font-weight: 900;
    font-size: 0.65rem;
    padding: 6px 18px;
    border-radius: 30px;
    letter-spacing: 2px;
    box-shadow: 0 5px 15px rgba(212, 175, 55, 0.4);
    z-index: 5;
    border: 2px solid rgba(255, 255, 255, 0.5);
    white-space: nowrap;
}

.rank-container-premium {
    width: 100%;
    margin: 15px 0;
}

.rank-bar-bg {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.rank-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-purple), var(--accent-cyan));
    box-shadow: 0 0 10px var(--accent-purple-glow);
    border-radius: 10px;
}

.rank-info-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-gray);
    font-weight: 700;
}

/* Re-using other essentials */
.screen {
    display: none;
    animation: fadeIn 0.4s ease;
}

.screen.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

#bottom-nav {
    height: var(--nav-height);
    background: rgba(8, 8, 10, 0.8);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--glass-border);
    display: flex;
    justify-content: space-around;
    align-items: center;
    position: fixed;
    bottom: 0;
    width: 100%;
    z-index: 100;
}

.nav-item {
    background: none;
    border: none;
    color: var(--text-gray);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
    cursor: pointer;
}

.nav-item.active {
    color: var(--accent-purple);
}

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(8, 8, 10, 0.95);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    z-index: 2000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
}

.overlay.active {
    display: flex;
}

.modal-content {
    width: 100%;
    max-width: 450px;
    padding: 30px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    position: relative;
    margin-top: 20px;
    margin-bottom: 60px; /* Extra space for scrolling on mobile */
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

@media (max-width: 480px) {
    .overlay {
        padding: 10px;
    }
    .modal-content {
        padding: 25px 20px;
        border-radius: 24px;
    }
    .form-group {
        margin-bottom: 15px;
    }
    .btn-close-modal {
        top: 15px !important;
        right: 15px !important;
    }
}

.form-group input, .form-group select, .form-group textarea {
    width: 100%;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--glass-border);
    padding: 12px 15px;
    border-radius: 12px;
    color: white;
    font-size: 0.95rem;
    transition: all 0.3s ease;
}

.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: var(--accent-purple);
    background: rgba(255, 255, 255, 0.05);
    outline: none;
}

.btn-primary {
    width: 100%;
    background: var(--accent-primary);
    border: none;
    color: var(--bg-dark);
    /* Contrast color */
    padding: 14px;
    border-radius: 50px;
    font-weight: 800;
    margin-top: 10px;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.btn-primary:hover {
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.discipline-selector-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: none;
}

.discipline-selector-tabs::-webkit-scrollbar {
    display: none;
}

.pay-tab {
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    color: var(--text-gray);
    font-size: 0.7rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: 0.3s;
}

.pay-tab.active {
    background: var(--accent-primary);
    color: var(--bg-dark);
    border-color: var(--accent-primary);
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
}

.moto-banner {
    background: linear-gradient(90deg, rgba(215, 245, 244, 0.2), rgba(6, 182, 212, 0.2));
    border: 1px solid var(--accent-purple);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 15px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
    animation: slideDown 0.4s ease;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Tournament Actions */
.st-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.st-actions {
    display: flex;
    gap: 8px;
}

.btn-st-action {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
    transition: 0.2s;
}

.btn-st-action i {
    width: 14px;
    height: 14px;
}

.btn-st-action.edit:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

.btn-st-action.delete:hover {
    border-color: #ef4444;
    color: #ef4444;
}

/* Dashboard Enhancements */
.level-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
}

.lvl-bar {
    width: 100px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
}

.lvl-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-purple), var(--accent-cyan));
}

.level-indicator span {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--accent-cyan);
    letter-spacing: 1px;
}

.daily-motivation {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 20px;
    margin-bottom: 25px;
    border-left: 4px solid var(--accent-purple);
    background: linear-gradient(90deg, rgba(215, 245, 244, 0.1), transparent);
}

.quote-icon {
    color: var(--accent-purple);
    opacity: 0.6;
}

.daily-motivation p {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.4;
}

.header-right {
    display: flex;
    align-items: flex-start;
}

/* Attendance Control Plus/Minus */
.attendance-controls {
    display: flex;
    gap: 10px;
    margin-bottom: 5px;
}

.ctrl-btn {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    color: white;
    background: rgba(255, 255, 255, 0.05);
}

.ctrl-btn.plus {
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
}

/* Navigation and Modals Refinement */
.ctrl-btn.minus {
    color: #ef4444;
    border-color: #ef4444;
}

/* Admin Panel Styles */
.admin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 25px;
}

.admin-card {
    padding: 20px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    cursor: pointer;
    transition: 0.3s;
}

.admin-card i {
    width: 32px;
    height: 32px;
    color: var(--accent-purple);
}

.admin-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
}

.admin-card h3 {
    font-size: 0.9rem;
    font-weight: 800;
}

.admin-card p {
    font-size: 0.7rem;
    color: var(--text-gray);
}

.mt-20 {
    margin-top: 20px;
}

.attendance-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.attendance-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    border-radius: 12px;
}

.attendance-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.attendance-user-info img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

.grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

/* Payment Status Badges */
.pay-status {
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
}

.pay-status.pending {
    background: rgba(234, 179, 8, 0.1);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.3);
}

.pay-status.approved {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
}

.receipt-preview {
    width: 60px;
    height: 60px;
    border-radius: 10px;
    object-fit: cover;
    margin-right: 15px;
    cursor: pointer;
    border: 1px solid var(--glass-border);
}

.admin-pay-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px;
    margin-bottom: 10px;
}

.admin-pay-info {
    display: flex;
    align-items: center;
}

.payment-actions {
    display: flex;
    gap: 10px;
}

.btn-approve {
    background: #22c55e;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.75rem;
    cursor: pointer;
}

.btn-reject {
    background: #ef4444;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.75rem;
    cursor: pointer;
}

.cls-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

.btn-st-action.delete-class {
    padding: 10px;
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.btn-st-action.delete-class:hover {
    background: #ef4444;
    color: white;
}

/* Admin Content Styles Update */
.admin-list-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.admin-header-premium {
    padding: 30px;
    background: radial-gradient(circle at center, #161616 0%, #000000 100%);
    border-radius: 20px;
    margin-bottom: 25px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
}

.admin-header-premium::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
}

.admin-header-premium h1 {
    color: white;
    font-size: 1.8rem;
    font-weight: 800;
    margin: 10px 0 5px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
}

.admin-item-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
}

.admin-item-card:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(5px);
}

.item-actions {
    display: flex;
    gap: 8px;
}

.item-actions button {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    min-width: 35px;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Specific button styles for actions */
.btn-primary-small {
    background: var(--accent-purple) !important;
    color: white !important;
    border-color: var(--accent-purple) !important;
    box-shadow: 0 2px 10px var(--accent-purple-glow);
}

.btn-glass-small {
    background: rgba(255, 255, 255, 0.03) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
}

.btn-glass-small.delete:hover {
    background: #ef4444 !important;
    border-color: #ef4444 !important;
    box-shadow: 0 2px 10px rgba(239, 68, 68, 0.2);
}

.item-actions button:hover {
    background: var(--accent-purple);
    border-color: var(--accent-purple);
}

.item-actions button.delete-cls-btn:hover,
.item-actions button.delete-plan-btn:hover,
.btn-reject:hover {
    background: #ef4444;
    border-color: #ef4444;
}

.p-20 {
    padding: 20px;
}

.mb-20 {
    margin-bottom: 20px;
}

.mt-20 {
    margin-top: 20px;
}

.btn-action-glow {
    background: var(--accent-primary);
    color: var(--bg-dark);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.3s;
}

.btn-action-glow:hover {
    transform: scale(1.05);
    box-shadow: 0 0 25px rgba(215, 245, 244, 0.6);
}

.btn-reserve-stitch.booked {
    background: #22c55e;
    color: white;
    box-shadow: 0 0 15px rgba(34, 197, 94, 0.4);
}

/* Dashboard Tournament Countdown Styles */
.tournament-countdown-card {
    background: linear-gradient(135deg, rgba(20, 20, 25, 0.95), rgba(215, 245, 244, 0.15));
    border: 1px solid rgba(255, 215, 0, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.countdown-bg-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(215, 245, 244, 0.2) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 1;
}

.trophy-pulse {
    background: rgba(255, 215, 0, 0.1);
    padding: 12px;
    border-radius: 16px;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.1);
    animation: goldPulse 3s infinite ease-in-out;
}

@keyframes goldPulse {

    0%,
    100% {
        transform: scale(1);
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.1);
    }

    50% {
        transform: scale(1.1);
        box-shadow: 0 0 40px rgba(255, 215, 0, 0.2);
    }
}

.countdown-digits {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    padding: 10px 15px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.countdown-digits .digit {
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(90deg, #fff, var(--text-gray));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.countdown-digits .unit {
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--text-gray);
    letter-spacing: 2px;
}

.tournament-progress-mini {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    margin-top: 15px;
    overflow: hidden;
}

.t-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #FFD700, var(--accent-cyan));
    box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
}

/* Smoke Gradient Discipline Cards */
.smoke-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 120%, rgba(255, 255, 255, 0.1), transparent 70%);
    mix-blend-mode: overlay;
    animation: smokeDrift 10s infinite linear;
    pointer-events: none;
    z-index: 1;
}

@keyframes smokeDrift {
    0% {
        transform: scale(1) translate(0, 0);
        opacity: 0.3;
    }

    50% {
        transform: scale(1.5) translate(5%, -10%);
        opacity: 0.6;
    }

    100% {
        transform: scale(1) translate(0, 0);
        opacity: 0.3;
    }
}

/* Themes */
.smoke-purple {
    background: linear-gradient(135deg, rgba(203, 242, 240, 0.1) 0%, rgba(203, 242, 240, 0.02) 100%);
    border-left: 4px solid #D7F5F4;
}

.smoke-cyan {
    background: linear-gradient(135deg, rgba(203, 242, 240, 0.12) 0%, rgba(203, 242, 240, 0.03) 100%);
    border-left: 4px solid #06b6d4;
}

.smoke-gold {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(203, 242, 240, 0.02) 100%);
    border-left: 4px solid #fbbf24;
}

.smoke-crimson {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(203, 242, 240, 0.02) 100%);
    border-left: 4px solid #ef4444;
}

/* Notifications UI */
.notification-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    margin-bottom: 12px;
    border-left: 3px solid var(--accent-purple);
    position: relative;
    overflow: hidden;
}

.notification-item.critical {
    border-left-color: #ef4444;
    background: linear-gradient(90deg, rgba(239, 68, 68, 0.1), transparent);
}

.notif-icon {
    width: 45px;
    height: 45px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-purple);
}

.notif-icon.pulse {
    animation: notifPulse 2s infinite;
    color: #ef4444;
}

@keyframes notifPulse {
    0% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
}

.notif-content h4 {
    font-size: 0.9rem;
    margin-bottom: 4px;
}

.notif-content p {
    font-size: 0.75rem;
    color: var(--text-gray);
    line-height: 1.3;
}

.notif-time {
    font-size: 0.65rem;
    color: var(--accent-cyan);
    font-weight: 700;
    margin-top: 5px;
    display: block;
}

.critical-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ef4444;
    color: white;
    font-size: 0.6rem;
    font-weight: 900;
    padding: 2px 6px;
    border-radius: 4px;
}

/* Luxury Gradient for Tournament Cards */
.luxury-gradient {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%) !important;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
}

.luxury-gradient::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(215, 245, 244, 0.06) 0%, transparent 75%);
    pointer-events: none;
}

.st-tag {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 6px;
    letter-spacing: 1px;
    display: inline-block;
    margin-bottom: 10px;
}

.day-checkbox-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    font-size: 0.7rem;
    color: var(--text-gray);
    font-weight: 700;
    transition: 0.2s;
    flex: 1;
    min-width: 40px;
}

.day-checkbox-label input {
    accent-color: var(--accent-purple);
    width: 16px;
    height: 16px;
}

.day-checkbox-label:hover {
    color: white;
}

/* --- Membership Selection Redesign (POST-REGISTRATION) --- */
.membership-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    z-index: 10000;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 20px;
}

.membership-screen.hidden {
    display: none;
}

.membership-screen-header {
    text-align: center;
    margin-bottom: 50px;
}

.membership-screen-header h1 {
    font-size: 1.8rem;
    font-weight: 900;
    color: white;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.membership-screen-header p {
    color: var(--text-gray);
    font-size: 0.9rem;
}

.plans-grid {
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: 100%;
    max-width: 400px;
    padding-bottom: 60px;
}

.plan-card {
    position: relative;

    perspective: 1500px;
    height: 520px;
    width: 100%;
    transition: transform 0.4s ease;
}

.pro-rata-option:hover {
    background: rgba(255,255,255,0.1) !important;
    border-color: rgba(255,255,255,0.3) !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

.plan-card:hover {
    transform: translateY(-5px);
}

/* .plan-card.popular styles are handled by .plan-card-front and .plan-card-back */

.popular-badge {
    position: absolute;
    top: 20px;
    right: -35px;
    background: #22c55e;
    color: black;
    padding: 6px 45px;
    font-size: 0.7rem;
    font-weight: 900;
    transform: rotate(45deg);
    box-shadow: 0 5px 15px rgba(34, 197, 94, 0.4);
    text-transform: uppercase;
}

.btn-skip-membership {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-gray);
    padding: 15px 40px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    width: auto;
    min-width: 250px;
}

.btn-skip-membership:hover {
    background: rgba(255, 255, 255, 0.08);
    color: white;
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Hero Card Color Variants */
/* Hero Card Premium Glass Variants */
.hero-card.next-class {
    transition: all 0.4s ease;
    border-radius: 32px;
}

.hero-card.next-class.smoke-purple {
    background: linear-gradient(135deg, rgba(215, 245, 244, 0.08) 0%, rgba(215, 245, 244, 0.03) 100%);
    border: 1px solid rgba(215, 245, 244, 0.3);
    box-shadow: 0 10px 30px rgba(215, 245, 244, 0.1);
}

.hero-card.next-class.smoke-purple .card-overlay {
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.95) 0%, rgba(215, 245, 244, 0.2) 100%);
}

.hero-card.next-class.smoke-cyan {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(6, 182, 212, 0.03) 100%);
    border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 10px 30px rgba(6, 182, 212, 0.1);
}

.hero-card.next-class.smoke-cyan .card-overlay {
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.95) 0%, rgba(6, 182, 212, 0.2) 100%);
}

.hero-card.next-class.smoke-gold {
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.08) 0%, rgba(234, 179, 8, 0.03) 100%);
    border: 1px solid rgba(234, 179, 8, 0.3);
    box-shadow: 0 10px 30px rgba(234, 179, 8, 0.1);
}

.hero-card.next-class.smoke-gold .card-overlay {
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.95) 0%, rgba(234, 179, 8, 0.2) 100%);
}

.hero-card.next-class.smoke-crimson {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(239, 68, 68, 0.03) 100%);
    border: 1px solid rgba(239, 68, 68, 0.3);
    box-shadow: 0 10px 30px rgba(239, 68, 68, 0.1);
}

.hero-card.next-class.smoke-crimson .card-overlay {
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.95) 0%, rgba(239, 68, 68, 0.2) 100%);
}

.plan-icon-wrapper {
    width: 85px;
    height: 85px;
    border-radius: 50%;
    margin: 0 auto 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    transition: 0.3s;
}

.plan-card:hover .plan-icon-wrapper {
    transform: scale(1.1);
}

.plan-card h2 {
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.plan-subtitle {
    font-size: 0.9rem;
    color: var(--text-gray);
    margin-bottom: 25px;
}

.plan-features {
    list-style: none;
    padding: 0;
    margin: 20px 0 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 10px;
}

.plan-features li {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
}

.plan-price {
    font-size: 1rem;
    font-weight: 800;
    margin-bottom: 30px;
    color: white;
}

.plan-price span {
    color: #22c55e;
    font-size: 1.4rem;
    font-weight: 900;
}

.btn-select-plan {
    width: 100%;
    padding: 16px;
    border-radius: 100px;
    border: none;
    background: #22c55e;
    color: black;
    font-weight: 900;
    font-size: 0.9rem;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.btn-select-plan:active {
    transform: scale(0.96);
}

.plan-card.bronze .plan-icon-wrapper {
    border-color: #854d0e;
    box-shadow: 0 0 20px rgba(133, 77, 14, 0.3);
}

.plan-card.silver .plan-icon-wrapper {
    border-color: #e2e8f0;
    box-shadow: 0 0 20px rgba(226, 232, 240, 0.3);
}

.plan-card.gold .plan-icon-wrapper {
    border-color: #fbbf24;
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
}

.plan-card.bronze h2 {
    color: #d97706;
}

.plan-card.silver h2 {
    color: #e2e8f0;
}

.plan-card.gold h2 {
    color: #fbbf24;
}

@media (min-width: 1024px) {
    .plans-grid {
        flex-direction: row;
        max-width: 1100px;
        gap: 20px;
    }

    .plan-card {
        flex: 1;
    }
}

/* Gamification Badges */
.badges-section {
    margin-top: 25px;
}

.badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.badge-item {
    aspect-ratio: 1;
    perspective: 1000px;
    cursor: pointer;
    position: relative;
}

.badge-item.locked {
    filter: grayscale(1);
    opacity: 0.3;
    cursor: help;
}

.badge-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
}

.badge-item.flipped .badge-card-inner {
    transform: rotateY(180deg);
}

.badge-card-front,
.badge-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
}

.badge-item:not(.locked) .badge-card-front {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
    animation: badge-float 3s ease-in-out infinite;
}

.badge-card-back {
    transform: rotateY(180deg);
    background: linear-gradient(135deg, rgba(203, 242, 240, 0.2) 0%, rgba(203, 242, 240, 0.05) 100%);
    border-color: rgba(203, 242, 240, 0.4);
    padding: 8px;
    text-align: center;
}

.badge-card-back p {
    font-size: 0.55rem;
    font-weight: 800;
    line-height: 1.2;
    color: white;
}

.badge-item:not(.locked)::after {
    content: "";
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 18px;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    z-index: -1;
}

@keyframes badge-float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }
}

.badge-icon i {
    width: 24px;
    height: 24px;
}

/* --- Plan Card Flip Effect --- */
.flip-hint {
    font-size: 0.75rem;
    color: var(--accent-purple);
    margin-top: 8px;
    opacity: 0.8;
    font-weight: 500;
}

.plan-card {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    perspective: 1000px;
    height: 480px;
}

.plan-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
}

.plan-card.flipped .plan-card-inner {
    transform: rotateY(180deg);
}

.plan-card-front,
.plan-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 32px;
    padding: 40px 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
}

.plan-card-back {
    transform: rotateY(180deg);
}

.plan-card.popular .plan-card-front,
.plan-card.popular .plan-card-back {
    border: 2px solid #22c55e;
    box-shadow: 0 0 40px rgba(34, 197, 94, 0.1);
}

.tap-hint {
    position: absolute;
    bottom: -5px;
    right: -5px;
    background: var(--accent-purple);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse-hint 2s infinite;
}

.tap-hint i {
    width: 12px;
    height: 12px;
    color: black;
}

@keyframes pulse-hint {
    0% {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.2);
        opacity: 0.5;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.back-trigger i {
    width: 20px;
    height: 20px;
}

.plan-card-back h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.plan-card-front .btn-select-plan,
.plan-card-back .btn-select-plan {
    width: 100%;
    margin-top: auto;
}

/* --- Membership Detail Animations --- */
@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.membership-card-interactive:hover {
    background: rgba(255, 255, 255, 0.05) !important;
}

.membership-card-interactive:active {
    scale: 0.98;
}

#membership-extra-details.hidden {
    display: none;
}

/* --- Admin Interactive Cards --- */
.interactive-member-card:hover {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: rgba(182, 229, 247, 0.3) !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
}

.interactive-member-card:active {
    transform: translateY(0);
}

.expand-icon {
    filter: drop-shadow(0 0 5px rgba(182, 229, 247, 0.3));
}

.stat-box-mini {
    transition: all 0.3s ease;
}

.stat-box-mini:hover {
    background: rgba(255, 255, 255, 0.06) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
}

/* --- Pro-Rata Info Screen --- */
.pro-rata-option {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.pro-rata-option:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
}

.pro-rata-option:active {
    transform: translateY(0) scale(0.98);
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

#pro-rata-info-screen {
    animation: fadeInScale 0.5s ease-out;
}

/* =============================================
   ELEGANT SCREEN TRANSITIONS
   ============================================= */
@keyframes elegantFadeIn {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes elegantFadeInSlow {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.screen-appear {
    animation: elegantFadeIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

/* Staggered children for screen content */
.screen-appear > * {
    opacity: 0;
    animation: elegantFadeInSlow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.screen-appear > *:nth-child(1) { animation-delay: 0.05s; }
.screen-appear > *:nth-child(2) { animation-delay: 0.10s; }
.screen-appear > *:nth-child(3) { animation-delay: 0.15s; }
.screen-appear > *:nth-child(4) { animation-delay: 0.20s; }
.screen-appear > *:nth-child(5) { animation-delay: 0.25s; }
.screen-appear > *:nth-child(6) { animation-delay: 0.30s; }
.screen-appear > *:nth-child(n+7) { animation-delay: 0.35s; }

/* Nested stagger for card grids */
.screen-appear > * > * {
    opacity: 0;
    animation: elegantFadeInSlow 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.screen-appear > *:nth-child(1) > *:nth-child(1) { animation-delay: 0.05s; }
.screen-appear > *:nth-child(2) > *:nth-child(1) { animation-delay: 0.08s; }
.screen-appear > *:nth-child(3) > *:nth-child(1) { animation-delay: 0.11s; }
.screen-appear > *:nth-child(4) > *:nth-child(1) { animation-delay: 0.14s; }
.screen-appear > *:nth-child(5) > *:nth-child(1) { animation-delay: 0.17s; }
.screen-appear > *:nth-child(n+6) > *:nth-child(1) { animation-delay: 0.20s; }
.screen-appear > * > *:nth-child(2) { animation-delay: 0.12s; }
.screen-appear > * > *:nth-child(3) { animation-delay: 0.19s; }
.screen-appear > * > *:nth-child(4) { animation-delay: 0.26s; }
.screen-appear > * > *:nth-child(n+5) { animation-delay: 0.33s; }

/* Collapsible Modules for Admin Panel */
.collapsible-header {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 5px;
}

.collapsible-header:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
}

.collapsible-content {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    padding-top: 10px;
}

.collapsible-header i, .collapsible-header svg {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-item-card.glass.interactive-member-card {
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.2s ease, border-color 0.2s ease;
}

.admin-item-card.glass.interactive-member-card:hover {
    transform: translateY(-4px) scale(1.01);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 10px 25px -10px rgba(0,0,0,0.5);
}

.admin-item-card.glass.interactive-member-card:active {
    transform: translateY(0) scale(0.99);
}

/* --- Admin Attendance Control Premium Styles --- */
.att-panel-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.att-panel-card:hover {
    background: rgba(255, 255, 255, 0.04) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.att-panel-card:active {
    transform: scale(0.99);
}

.att-date-divider {
    position: relative;
    padding-left: 10px;
}

.att-date-divider::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 12px;
    background: var(--accent-purple);
    border-radius: 10px;
}

.stat-mini-premium {
    transition: all 0.3s ease;
}

.stat-mini-premium:hover {
    background: rgba(255, 255, 255, 0.04) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
}

.att-period-btn {
    position: relative;
    overflow: hidden;
}

.att-period-btn:active {
    transform: scale(0.95);
}

#att-period-content {
    animation: fadeInAttendance 0.4s ease-out;
}

@keyframes fadeInAttendance {
     from { opacity: 0; transform: translateY(10px); }
     to { opacity: 1; transform: translateY(0); }
}
