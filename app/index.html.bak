<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>amarufighter</title>
    <link rel="stylesheet" href="style.css">
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
        rel="stylesheet">
    <link rel="manifest" href="manifest.json">
    <link rel="icon" type="image/png" href="/images/icon-192.png">
    <link rel="apple-touch-icon" href="/images/icon-192.png">
    <link rel="stylesheet" href="style.css">
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <!-- Third-party SDKs -->
    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <!-- App Config & Logic (Vite modules) -->
    <script type="module" src="./firebase-config.js"></script>
    <script type="module" src="./supabase-config.js"></script>
    <script type="module" src="./app.js"></script>
    <script type="module">
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                // Use absolute path so it resolves correctly at any URL depth
                navigator.serviceWorker.register('/app/sw.js', { scope: '/app/' })
                    .then((reg) => {
                        console.log('Service Worker Registrado: ', reg);
                        // If there's an active worker, initialize messaging
                        if (reg.active) {
                            if (typeof initMessaging === 'function') initMessaging();
                        } else {
                            // Wait for it to become active
                            reg.addEventListener('updatefound', () => {
                                const newWorker = reg.installing;
                                newWorker.addEventListener('statechange', () => {
                                    if (newWorker.state === 'activated') {
                                        if (typeof initMessaging === 'function') initMessaging();
                                    }
                                });
                            });
                        }
                    })
                    .catch((err) => console.error('Error de Service Worker: ', err));
            });
        }
    </script>
    <!-- Scripts para exportar a Excel y PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

</head>

<body class="dark-theme">
    <!-- Auth Screen -->
    <div id="auth-screen" class="screen active">
        <div class="auth-container" style="position: relative;">
            <a href="../index.html" class="btn-return-landing" title="Volver al inicio"
                style="position: absolute; top: 15px; left: 15px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: white; cursor: pointer; transition: 0.3s; z-index: 10;">
                <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
            </a>
            <div class="auth-header">
                <h1>Amaru<span>App</span></h1>
                <p id="auth-subtitle">Entra a la élite del entrenamiento</p>
            </div>

            <div id="login-form-container">
                <div class="auth-form-group">
                    <label>EMAIL</label>
                    <div class="auth-input-wrapper">
                        <i data-lucide="mail"></i>
                        <input type="email" id="login-email" class="auth-input" placeholder="tu@email.com">
                    </div>
                </div>
                <div class="auth-form-group">
                    <label>CONTRASEÑA</label>
                    <div class="auth-input-wrapper">
                        <i data-lucide="lock"></i>
                        <input type="password" id="login-password" class="auth-input" placeholder="••••••••">
                    </div>
                </div>
                <button id="btn-login" class="auth-btn">INICIAR SESIÓN</button>

                <div class="auth-divider"><span>O continúa con</span></div>

                <button id="btn-google-login" class="auth-btn google-btn">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google">
                    INICIAR CON GOOGLE
                </button>

                <p class="form-toggle">¿No tienes cuenta? <span id="go-to-register">Regístrate</span></p>

            </div>

            <div id="register-form-container" class="hidden">
                <div class="auth-form-group">
                    <label>NOMBRE COMPLETO</label>
                    <div class="auth-input-wrapper">
                        <i data-lucide="user"></i>
                        <input type="text" id="reg-name" class="auth-input" placeholder="Alex Marshall">
                    </div>
                </div>
                <div class="auth-form-group">
                    <label>EMAIL</label>
                    <div class="auth-input-wrapper">
                        <i data-lucide="mail"></i>
                        <input type="email" id="reg-email" class="auth-input" placeholder="tu@email.com">
                    </div>
                </div>
                <div class="auth-form-group">
                    <label>CONTRASEÑA</label>
                    <div class="auth-input-wrapper">
                        <i data-lucide="lock"></i>
                        <input type="password" id="reg-password" class="auth-input" placeholder="Mínimo 6 caracteres">
                    </div>
                </div>
                <button id="btn-register" class="auth-btn">CREAR CUENTA</button>
                <p class="form-toggle">¿Ya tienes cuenta? <span id="go-to-login">Inicia sesión</span></p>
            </div>
        </div>
    </div>

    <!-- Pro-Rata Info Screen -->
    <div id="pro-rata-info-screen" class="membership-screen hidden"
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center; height: 100vh; background: var(--bg-color); z-index: 50;">
        <i data-lucide="info" style="width: 60px; height: 60px; color: var(--accent-yellow); margin-bottom: 20px;"></i>
        <h2 style="margin-bottom: 15px; font-weight: 800; font-size: 1.8em;">Inscripción de Medio Mes</h2>
        <p style="margin-bottom: 30px; line-height: 1.6; color: #ccc; max-width: 500px; font-size: 1.1em;">
            Al inscribirte a partir del día 15 de cada mes, habilitamos dos opciones excepcionales para el cobro de tu
            primera mensualidad:
        </p>

        <p style="margin-bottom: 15px; font-size: 1em; color: var(--accent-yellow); font-weight: 600;">
            👇 Haz clic en la opción de tu preferencia para continuar a los planes:
        </p>

        <div id="btn-option-proportional" class="pro-rata-option"
            style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; margin-bottom: 15px; text-align: left; max-width: 500px; width: 100%; cursor: pointer; transition: all 0.3s;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                <i data-lucide="calculator" style="color: #22c55e;"></i>
                <h3 style="margin: 0; font-size: 1.1rem; pointer-events: none;">Opción 1: Proporcional</h3>
            </div>
            <p style="color: #aaa; font-size: 0.9em; margin: 0; line-height: 1.5; pointer-events: none;">Paga un monto
                proporcional sólo por los días restantes del mes actual + un mínimo cargo por servicio.</p>
        </div>

        <div id="btn-option-full" class="pro-rata-option"
            style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; margin-bottom: 30px; text-align: left; max-width: 500px; width: 100%; cursor: pointer; transition: all 0.3s;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                <i data-lucide="calendar-check" style="color: #60a5fa;"></i>
                <h3 style="margin: 0; font-size: 1.1rem; pointer-events: none;">Opción 2: Mes Nuevo Completo</h3>
            </div>
            <p style="color: #aaa; font-size: 0.9em; margin: 0; line-height: 1.5; pointer-events: none;">Paga tu
                membresía por adelantado y asegura tu cupo para el próximo ciclo. Así podrás comenzar a entrenar desde
                el primer día hábil del mes.</p>
        </div>
    </div>

    <!-- Membership Selection Screen (Premium Design) -->
    <div id="membership-selection-screen" class="membership-screen hidden">
        <div class="membership-screen-header">
            <h1>Elige tu Plan</h1>
            <p>Selecciona la membresía que mejor se adapte a tus objetivos</p>
            <p class="flip-hint"><i data-lucide="info" style="width:12px; vertical-align:middle; margin-right:4px;"></i>
                Toca el ícono del escudo para ver detalles del plan</p>
        </div>

        <div id="promo-code-container" style="text-align: center; margin-bottom: 20px;">
            <input type="text" id="promo-code-input" placeholder="¿Tienes código de descuento?" class="input-glass"
                style="max-width: 250px; display: inline-block; text-transform: uppercase;">
            <button id="btn-apply-promo" class="btn-primary" style="padding: 10px 15px;">Aplicar</button>
            <p id="promo-code-message" style="display: none; font-size: 0.9em; margin-top: 10px; font-weight: bold;">
            </p>
        </div>

        <div id="membership-plans-container" class="plans-grid">
            <!-- Plans will be rendered here dynamically -->
        </div>

        <button id="btn-skip-membership" class="btn-skip-membership">
            Omitir por ahora y explorar
        </button>
    </div>

    <div id="app-container" class="hidden">
        <!-- Screens Container -->
        <main id="main-content">
            <!-- Billing Alert (Top Sticky if due) -->
            <div id="billing-alert" class="glass billing-banner hidden">
                <div class="alert-content">
                    <i data-lucide="alert-circle"></i>
                    <p>Hoy es día 5: Cobro de membresía realizado con éxito. ✨</p>
                </div>
                <button class="btn-close-banner">×</button>
            </div>

            <!-- Dashboard Screen -->
            <section id="dashboard" class="screen active">
                <header class="screen-header">
                    <div class="user-welcome">
                        <span class="greeting">¡Hola!</span>
                        <h1 class="welcome-text">Listo para entrenar ⚡</h1>
                        <div class="level-indicator">
                            <div class="lvl-bar">
                                <div class="lvl-fill" style="width: 65%;"></div>
                            </div>
                            <span>--</span>
                        </div>
                    </div>
                    <div class="header-right">
                        <div class="streak-badge">
                            <i data-lucide="flame"></i>
                            <span id="user-streak-text">0 Días</span>
                        </div>
                        <button id="btn-dashboard-back-admin" class="btn-action-glow hidden"
                            style="margin-left: 10px; background: #ef4444; border:none; width: auto; padding: 10px 15px; font-size: 0.75rem;">
                            <i data-lucide="shield-check" style="width: 14px; margin-right:5px;"></i> PANEL ADMIN
                        </button>
                    </div>
                </header>

                <div class="daily-motivation glass">
                    <i data-lucide="quote" class="quote-icon"></i>
                    <p id="motivational-quote">"El único entrenamiento malo es el que no sucedió."</p>
                </div>

                <div id="dynamic-next-class" class="hero-card next-class">
                    <!-- Dynamic Next Class Content -->
                </div>

                <div class="stats-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="stat-card glass"
                        style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 15px; position: relative; overflow: hidden;">
                        <span id="completed-classes-count"
                            style="font-size: 2.2rem; font-weight: 800; color: white; display: flex; align-items: baseline; gap: 4px;">
                            0 <span style="font-size: 1rem; color: var(--text-gray); font-weight: 600;">/ 20</span>
                        </span>
                        <span class="stat-label"
                            style="font-size: 0.8rem; margin-top: 5px; color: var(--text-gray); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Clases
                            Activas</span>
                        <div style="position: absolute; bottom: -10px; right: -10px; opacity: 0.05;">
                            <i data-lucide="activity" style="width: 80px; height: 80px;"></i>
                        </div>
                    </div>

                    <div class="stat-card glass">
                        <div class="progress-ring-container">
                            <svg class="progress-ring" width="80" height="80">
                                <circle class="progress-ring__circle-bg" stroke="rgba(255,255,255,0.1)" stroke-width="6"
                                    fill="transparent" r="30" cx="40" cy="40" />
                                <circle id="attendance-circle" class="progress-ring__circle"
                                    stroke="var(--accent-purple)" stroke-width="6" stroke-dasharray="188.5"
                                    stroke-dashoffset="188.5" fill="transparent" r="30" cx="40" cy="40" />
                            </svg>
                            <span id="attendance-percent" class="progress-value">0%</span>
                        </div>
                        <span class="stat-label">Tu Meta Mensual</span>
                    </div>
                </div>



            </section>

            <!-- Schedule Screen -->
            <section id="schedule" class="screen">
                <header class="section-header-premium">
                    <h2>Agenda de Clases</h2>
                    <div class="date-carousel-premium">
                        <div class="date-chip"><span>LUN</span>
                            <p>10</p>
                        </div>
                        <div class="date-chip active"><span>MAR</span>
                            <p>11</p>
                        </div>
                        <div class="date-chip"><span>MIÉ</span>
                            <p>12</p>
                        </div>
                        <div class="date-chip"><span>JUE</span>
                            <p>13</p>
                        </div>
                        <div class="date-chip"><span>VIE</span>
                            <p>14</p>
                        </div>
                        <div class="date-chip"><span>SÁB</span>
                            <p>15</p>
                        </div>
                    </div>
                </header>

                <div class="filters-premium">
                    <button class="filter-tag active">Todas</button>
                    <button class="filter-tag">Striking</button>
                    <button class="filter-tag">BJJ</button>
                    <button class="filter-tag">Kettlebel</button>
                </div>

                <div class="class-timeline">
                    <!-- Dynamic Classes with Stitch styling -->
                </div>
            </section>

            <!-- Tournaments Screen -->
            <section id="tournaments" class="screen">
                <header class="section-header-premium">
                    <div class="header-split">
                        <div>
                            <h2>Arena de Torneos</h2>
                            <p class="subtitle">Mide tu progreso en el tatami</p>
                        </div>
                        <button id="add-tourney-btn" class="btn-action-glow">
                            <i data-lucide="plus"></i>
                        </button>
                    </div>
                </header>

                <div class="tournament-selector">
                    <button class="sel-tab active" data-tab="upcoming">PRÓXIMOS</button>
                    <button class="sel-tab" data-tab="history">PASADOS</button>
                </div>

                <div id="tourney-list" class="premium-tourney-grid">
                    <!-- Tournament cards with background images -->
                </div>
            </section>

            <!-- Profile Screen -->
            <section id="profile" class="screen">
                <div class="profile-main-card glass-premium">
                    <div class="profile-header-premium">
                        <div class="avatar-container-luxury">
                            <div class="avatar-outer-glow"></div>
                            <div class="avatar-inner-frame">
                                <img id="profile-avatar" src="../images/unknow.png" alt="Atleta"
                                    class="avatar-image-premium">
                                <div class="avatar-glare"></div>
                                <div class="avatar-actions-overlay">
                                    <button id="btn-edit-avatar" title="Cambiar foto"><i
                                            data-lucide="camera"></i></button>
                                    <button id="btn-delete-avatar" title="Eliminar foto" class="delete"><i
                                            data-lucide="trash-2"></i></button>
                                </div>
                            </div>
                            <input type="file" id="avatar-input" accept="image/*" class="hidden">
                            <div id="user-rank-status" class="rank-badge">Cargando...</div>
                        </div>
                        <h2 id="profile-user-name" class="user-name-premium">Cargando...</h2>
                        <p id="profile-user-level"
                            style="font-size: 0.9rem; font-weight: 700; color: #a0a0a0; margin-top: 5px; text-transform: uppercase;">
                            NIVEL: <span style="color: white;">--</span></p>
                        <div class="rank-container-premium">
                            <div class="rank-bar-bg">
                                <div class="rank-bar-fill" style="width: 75%;"></div>
                            </div>
                            <div class="rank-info-text">
                                <span>3450 / 5000 XP</span>
                                <strong>75%</strong>
                            </div>
                        </div>
                        <div class="user-style-selection"
                            style="margin-top: 10px; display: flex; flex-direction: column; align-items: center; gap: 5px;">
                            <span style="font-size: 0.75rem; color: var(--text-gray); font-weight: bold;">TU ESTILO DE
                                COMBATE:</span>
                            <select id="user-combat-style"
                                style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 5px 10px; font-size: 0.85rem; font-weight: bold;">
                                <option value="striker" style="color: black;">Striker</option>
                                <option value="grappler" style="color: black;">Grappler</option>
                                <option value="hybrid" style="color: black;">Híbrido</option>
                            </select>
                        </div>
                        <button id="btn-back-admin" class="btn-primary hidden"
                            style="margin-top: 15px; background: #ef4444; width: auto; padding: 12px 25px; font-size: 0.8rem; font-weight: 800;">
                            <i data-lucide="shield-check" style="width: 16px; margin-right:8px;"></i> PANEL
                            ADMINISTRATIVO
                        </button>
                    </div>

                    <!-- Current Membership Progress (Integrated) -->
                    <div id="current-membership-progress" class="glass"
                        style="margin-top: 20px; background: rgba(255,255,255,0.02); padding: 15px; border-radius: 12px; border: 1px solid var(--glass-border);">
                        <!-- Rendered by JS -->
                        <p style="text-align:center; font-size:0.8rem; color:var(--text-gray);">Cargando tu progreso de
                            membresía...</p>
                    </div>

                    <div id="btn-logout" class="glass"
                        style="margin-top: 20px; text-align: center; border-color: #ef4444; color: #ef4444; cursor: pointer; padding: 12px; font-weight: 700; border-radius: 16px;">
                        <i data-lucide="log-out" style="width: 16px; margin-right: 8px; vertical-align: middle;"></i>
                        CERRAR SESIÓN
                    </div>


                </div>

                <!-- Badges Section (Request #2) -->
                <div class="badges-section glass mt-20" style="padding: 20px; border-radius: 20px;">
                    <div class="section-title"
                        style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <i data-lucide="award" style="color: var(--accent-purple);"></i>
                        <h3>Tus Medallas</h3>
                    </div>
                    <div class="badges-grid" id="user-badges-container"
                        style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px;">
                        <div class="badge-item locked" title="Guerrero Novato: Asiste a 5 clases">
                            <div class="badge-icon"><i data-lucide="shield"></i></div>
                        </div>
                        <div class="badge-item locked" title="Asistencia Perfecta: Completa una semana">
                            <div class="badge-icon"><i data-lucide="calendar-check"></i></div>
                        </div>
                        <div class="badge-item locked" title="Madrugador: Clase antes de las 9 AM">
                            <div class="badge-icon"><i data-lucide="sun"></i></div>
                        </div>
                        <div class="badge-item locked" title="Leyenda: Alcanza el nivel 50">
                            <div class="badge-icon"><i data-lucide="crown"></i></div>
                        </div>
                    </div>
                </div>

                <div class="attendance-viz glass">
                    <div class="viz-header">
                        <h3>Actividad Mensual</h3>
                        <i data-lucide="trending-up" class="icon-accent"></i>
                    </div>
                    <div class="chart-container">
                        <canvas id="attendanceChart"></canvas>
                    </div>
                </div>

                <div class="payment-section glass">
                    <div class="section-title"
                        style="margin-bottom: 20px; display:flex; justify-content:space-between; align-items:center;">
                        <h3>Membresías</h3>
                        <div style="display:flex; gap: 8px;">
                            <button class="btn-glass" id="btn-view-plans"
                                style="padding: 6px 14px; font-size: 0.7rem; background: var(--accent-purple); color: var(--bg-dark); border: none; font-weight: bold; cursor:pointer;">
                                Ver Planes
                            </button>
                        </div>
                    </div>

                    <h4 style="font-size: 0.8rem; margin-bottom: 15px; color: var(--text-gray);">Historial de Pagos</h4>
                    <ul class="payment-premium-list" id="payment-history-list">
                        <!-- Dynamic payments here -->
                    </ul>
                    <div style="margin-top: 40px; text-align: center; opacity: 0.6; font-size: 0.75rem;">
                        <a href="/privacy.html" target="_blank"
                            style="color: var(--text-gray); text-decoration: none;">Política de Privacidad</a>
                        <p style="margin-top: 5px;">Amaru App v1.2.0</p>
                    </div>
                </div>

            </section>

            <!-- Admin Screen -->
            <section id="admin-panel" class="screen">
                <div class="admin-header-premium">
                    <div style="display: flex; justify-content: flex-end; align-items: flex-start;">
                        <button id="btn-exit-admin-mode" class="btn-glass"
                            style="padding: 6px 14px; font-size: 0.65rem; border-color: rgba(255,255,255,0.3); display: flex; align-items: center; gap: 5px;">
                            <i data-lucide="log-out" style="width: 12px;"></i> SALIR DEL MODO ADMIN
                        </button>
                    </div>
                    <h1>Panel Administrativo</h1>
                    <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem;">Control central de operaciones y alumnos
                    </p>
                </div>


                <div class="admin-grid">
                    <div class="admin-card glass" id="manage-classes-btn">
                        <i data-lucide="calendar-days"></i>
                        <div class="admin-card-text">
                            <h3>Gestión de Clases</h3>
                            <p>Crear, editar o eliminar horarios</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="view-attendance-btn">
                        <i data-lucide="users"></i>
                        <div class="admin-card-text">
                            <h3>Control de Asistencia</h3>
                            <p>Revisar registros de todos los alumnos</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="manage-payments-btn">
                        <i data-lucide="receipt"></i>
                        <div class="admin-card-text">
                            <h3>Control de Pagos</h3>
                            <p>Validar comprobantes y mensualidades</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="manage-users-btn">
                        <i data-lucide="award"></i>
                        <div class="admin-card-text">
                            <h3>Gestión de Membresías</h3>
                            <p>Membresías, límites y planes</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="manage-active-users-btn">
                        <i data-lucide="user-cog"></i>
                        <div class="admin-card-text">
                            <h3>Control de Socios</h3>
                            <p>Resumen de cada socio activo</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="manage-discounts-btn">
                        <i data-lucide="percent"></i>
                        <div class="admin-card-text">
                            <h3>Descuentos</h3>
                            <p>Promociones y códigos influencers</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="view-revenue-btn">

                        <i data-lucide="trending-up"></i>
                        <div class="admin-card-text">
                            <h3>Ingresos 📊</h3>
                            <p>Ver estadísticas de recaudación</p>
                        </div>
                    </div>
                    <div class="admin-card glass" id="manage-notifications-btn">
                        <i data-lucide="bell-ring"></i>
                        <div class="admin-card-text">
                            <h3>Avisos Globales 📢</h3>
                            <p>Enviar comunicados a todos</p>
                        </div>
                    </div>
                </div>

                <div id="admin-revenue-section" class="attendance-viz glass mt-20 hidden">
                    <div class="viz-header" style="flex-direction: column; align-items: flex-start; gap: 15px;">
                        <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                            <h3>Tendencia de Recaudación</h3>
                            <div style="display:flex; gap:8px; align-items:center;">
                                <select id="export-format-rev" style="background: rgba(255,255,255,0.05); color: var(--text-gray); border: 1px solid var(--glass-border); padding: 5px 8px; border-radius: 6px; font-size: 0.7rem; outline: none;">
                                    <option value="csv">CSV</option>
                                    <option value="xls">XLS</option>
                                    <option value="pdf">PDF</option>
                                </select>
                                <button id="btn-export-revenue" class="btn-primary" style="padding: 6px 12px; font-size: 0.70rem; border-radius: 8px;">Exportar</button>
                            </div>
                        </div>
                        <div class="tag" style="background: rgba(34, 197, 94, 0.2); color: #22c55e;">
                            <select id="revenue-timeframe"
                                style="background:none; color:inherit; border:none; outline:none; font-weight:bold; cursor:pointer;">
                                <option value="mensual" style="color:black;">Mensual</option>
                                <option value="semestral" style="color:black;">Semestral</option>
                                <option value="anual" style="color:black;">Anual</option>
                            </select>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                    <div class="revenue-stats mt-20">
                        <div class="stat-mini">
                            <span id="admin-total-label">TOTAL MES</span>
                            <strong id="admin-total-month">$0.00</strong>
                        </div>
                        <div style="display: flex; gap: 8px; margin-top: 15px; align-items: center; justify-content: flex-end;">
                            <select id="export-format-rev" style="background: rgba(255,255,255,0.05); color: var(--text-gray); border: 1px solid var(--glass-border); padding: 5px 8px; border-radius: 6px; font-size: 0.7rem; outline: none; flex: 1;">
                                <option value="csv" style="color: black;">Formato CSV</option>
                                <option value="xls" style="color: black;">Formato XLS</option>
                                <option value="pdf" style="color: black;">Formato PDF</option>
                            </select>
                            <button id="btn-export-report" class="btn-primary" style="padding: 8px 15px; font-size: 0.70rem;">
                                <i data-lucide="download" style="width: 14px; height: 14px; margin-right: 4px; vertical-align: middle;"></i> Exportar
                            </button>
                        </div>
                    </div>
                </div>




                <div id="admin-content-area" class="mt-20">
                    <!-- Dynamic admin content will load here -->
                </div>
            </section>

            <!-- Pantalla: Notificaciones -->
            <section id="notifications" class="screen">
                <div class="header-premium">
                    <h1>Notificaciones</h1>
                    <p>Alertas y avisos de torneos 🔔</p>
                </div>
                <div id="notifications-list" class="notifications-container p-20">
                    <!-- Dinámico -->
                </div>
            </section>
        </main>


        <!-- Bottom Navigation -->
        <nav id="bottom-nav">
            <button class="nav-item active" data-screen="dashboard">
                <i data-lucide="home"></i>
                <span>Inicio</span>
            </button>
            <button class="nav-item" data-screen="schedule">
                <i data-lucide="calendar"></i>
                <span>Agenda</span>
            </button>
            <button class="nav-item" data-screen="tournaments">
                <i data-lucide="trophy"></i>
                <span>Torneos</span>
            </button>
            <button class="nav-item" data-screen="notifications">
                <i data-lucide="bell"></i>
                <span>Avisos</span>
            </button>
            <button class="nav-item" data-screen="profile">
                <i data-lucide="user"></i>
                <span>Perfil</span>
            </button>
            <button class="nav-item hidden" data-screen="admin-panel" id="nav-admin">
                <i data-lucide="shield-check"></i>
                <span>Admin</span>
            </button>
        </nav>

    </div>

    <!-- Motivational Alerts Container -->
    <div id="motivation-container"></div>



    <!-- Modals / Overlays -->
    <div id="checkin-overlay" class="overlay">
        <div class="qr-container glass">
            <h2>Escanea para entrar</h2>
            <div class="qr-placeholder">
                <i data-lucide="qr-code"></i>
            </div>
            <p>AmaruApp ID: AM-9923</p>
            <button class="btn-close">Cerrar</button>
        </div>
    </div>

    <!-- Lucide & Chart.js -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Class Management Modal -->
    <div id="class-modal" class="overlay">
        <div class="modal-content glass">
            <div class="modal-header">
                <h3 id="class-modal-title">Nueva Clase</h3>
                <button class="btn-close-modal">×</button>
            </div>
            <form id="class-form">
                <div class="form-group">
                    <label>Nombre de la Clase</label>
                    <input type="text" id="cls-name" placeholder="Ej: BJJ Avanzado" required>
                </div>
                <div class="form-group">
                    <label>Coach</label>
                    <input type="text" id="cls-coach" placeholder="Nombre del instructor" required>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Hora</label>
                        <input type="time" id="cls-time" required>
                    </div>
                    <div class="form-group">
                        <label>Tipo</label>
                        <select id="cls-type">
                            <option value="Striking">Striking</option>
                            <option value="BJJ">BJJ</option>
                            <option value="Funcional Fighter">Funcional Fighter</option>
                            <option value="MMA">MMA</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Tema de Clase (Estilo y Color)</label>
                    <select id="cls-theme"
                        style="width:100%; padding:10px; background:rgba(255,255,255,0.05); color:white; border:1px solid rgba(255,255,255,0.1); border-radius:12px;">
                        <option value="smoke-purple" style="color:black;">Morado Místico (Purple)</option>
                        <option value="smoke-cyan" style="color:black;">Cyan Eléctrico (Cyan)</option>
                        <option value="smoke-gold" style="color:black;">Dorado Campeón (Gold)</option>
                        <option value="smoke-crimson" style="color:black;">Furia Carmesí (Crimson)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Días de la Semana</label>
                    <div id="cls-days-container"
                        style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; background: rgba(255,255,255,0.03); padding: 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="1"> Lun</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="2"> Mar</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="3"> Mie</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="4"> Jue</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="5"> Vie</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="6"> Sab</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="cls-day" value="0"> Dom</label>
                    </div>
                </div>

                <button type="submit" class="btn-primary">GUARDAR CLASE 🥋</button>
            </form>
        </div>
    </div>

    <!-- Payment Report Modal -->
    <div id="payment-modal" class="overlay">
        <div class="modal-content glass">
            <div class="modal-header">
                <h3>Informar Pago</h3>
                <button class="btn-close-modal">×</button>
            </div>
            <form id="payment-form">
                <div class="form-group">
                    <label>Monto a Pagar ($)</label>
                    <input type="number" id="pay-amount" placeholder="Ej: 45.00" required>
                </div>
                <div class="form-group">
                    <label>Mes de Ingreso</label>
                    <select id="pay-month" class="auth-input"
                        style="background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.1); padding: 12px; border-radius: 12px; width: 100%;">
                        <!-- Dynamic options or static for now -->
                        <option value="actual">Mes Actual</option>
                        <option value="proximo">Próximo Mes</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Disciplina / Plan</label>
                    <div class="discipline-selector-tabs" id="pay-discipline-tabs">
                        <button type="button" class="pay-tab active" data-price="25000"
                            data-name="Primer Asalto">ASALTO</button>
                        <button type="button" class="pay-tab" data-price="38000"
                            data-name="Guerrero Constante">GUERRERO</button>
                        <button type="button" class="pay-tab" data-price="55000"
                            data-name="Elite Amarufighter">ELITE</button>
                    </div>
                    <input type="hidden" id="pay-concept" value="Primer Asalto">
                </div>
                <div class="form-group">
                    <label>Comprobante (Imagen)</label>
                    <div class="auth-input-wrapper">
                        <input type="file" id="pay-receipt" accept="image/*" required style="padding: 10px;">
                    </div>
                </div>
                <button type="submit" class="btn-primary">ENVIAR COMPROBANTE 📩</button>
            </form>
        </div>
    </div>
    <!-- Membership Plan Management Modal -->
    <div id="plan-modal" class="overlay">
        <div class="modal-content glass">
            <div class="modal-header">
                <h3 id="plan-modal-title">Nuevo Plan</h3>
                <button class="btn-close-modal">×</button>
            </div>
            <form id="plan-form">
                <div class="form-group">
                    <label>Nombre del Plan</label>
                    <input type="text" id="plan-name" placeholder="Ej: Elite Anual" required>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Precio ($)</label>
                        <input type="number" id="plan-price" placeholder="45.00" required>
                    </div>
                    <div class="form-group" style="display: flex; gap: 10px;">
                        <div style="flex: 1;">
                            <label>Clases x Día</label>
                            <input type="number" id="plan-limit" placeholder="2" required>
                        </div>
                        <div style="flex: 1;">
                            <label>Mensuales</label>
                            <input type="number" id="plan-monthly" placeholder="20" required>
                        </div>
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Subtítulo</label>
                        <input type="text" id="plan-subtitle" placeholder="Ej: Acceso Ilimitado">
                    </div>
                    <div class="form-group">
                        <label>Tema (Diseño)</label>
                        <select id="plan-theme"
                            style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; padding: 10px; width: 100%;">
                            <option value="bronze">Bronce</option>
                            <option value="silver">Plata</option>
                            <option value="gold">Oro</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Características (Separadas por comas)</label>
                    <input type="text" id="plan-features" placeholder="Rutinas, Clases, Coach...">
                </div>
                <div class="form-group"
                    style="display: flex; align-items: center; gap: 10px; background: rgba(139, 92, 246, 0.1); padding: 10px; border-radius: 8px; border: 1px solid rgba(139, 92, 246, 0.2);">
                    <input type="checkbox" id="plan-popular" style="width: auto;">
                    <label for="plan-popular" style="margin: 0; font-size: 0.8rem; cursor: pointer;">Destacar como
                        "Recomendado" ⭐</label>
                </div>
                <div class="form-group">
                    <label>Días de Validez (Opcional)</label>
                    <div id="plan-days-container"
                        style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; background: rgba(255,255,255,0.03); padding: 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="1"> Lun</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="2"> Mar</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="3"> Mie</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="4"> Jue</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="5"> Vie</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="6"> Sab</label>
                        <label class="day-checkbox-label"><input type="checkbox" name="plan-day" value="0"> Dom</label>
                    </div>
                    <p style="font-size: 0.6rem; color: var(--text-gray); margin-top: 5px;">Si no marcas ninguno, el
                        plan será válido para todos los días.</p>
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    <textarea id="plan-desc" placeholder="Beneficios del plan..." rows="2"
                        style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; padding: 10px; width: 100%;"></textarea>
                </div>
                <button type="submit" class="btn-primary">GUARDAR PLAN 💎</button>
            </form>
        </div>
    </div>
    <!-- Member Management Modal -->
    <div id="member-modal" class="overlay">
        <div class="modal-content glass">
            <div class="modal-header">
                <h3 id="member-modal-title">Nuevo Socio</h3>
                <button class="btn-close-modal">×</button>
            </div>
            <form id="member-form">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" id="mem-name" placeholder="Ej: Juan Pérez" required>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="mem-email" placeholder="email@ejemplo.com" required>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Nivel</label>
                        <input type="number" id="mem-level" placeholder="1" required>
                    </div>
                    <div class="form-group">
                        <label>Fecha de Ingreso</label>
                        <input type="date" id="mem-entry-date" required>
                    </div>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Membresía</label>
                    <select id="mem-plan"
                        style="background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.1); padding: 12px; border-radius: 12px; width: 100%;">
                        <option value="" style="color: black;">Sin Plan (Inactivo)</option>
                        <!-- Populated dynamically via JS -->
                    </select>
                </div>

                <div id="admin-payment-tools" class="hidden"
                    style="margin-top: 15px; padding: 15px; background: rgba(239, 68, 68, 0.05); border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.2); margin-bottom: 15px;">
                    <label
                        style="font-size: 0.7rem; color: #ef4444; margin-bottom: 8px; display: block; font-weight: 800; letter-spacing: 1px;">
                        ESTADO DE MEMBRESÍA: INACTIVO / SIN PLAN</label>
                    <button type="button" id="btn-admin-req-payment" class="btn-glass"
                        style="width: 100%; border-color: #ef4444; color: #ef4444; display: flex; align-items: center; justify-content: center; gap: 10px;">
                        <i data-lucide="alert-circle"></i> ENVIAR A PAGOS PENDIENTES
                    </button>
                    <p style="font-size: 0.6rem; color: var(--text-gray); margin-top: 8px; text-align: center;">Genera
                        un registro automático para cobrar la renovación.</p>
                </div>
                <div id="admin-pass-tools" class="hidden"
                    style="margin-top: 15px; padding: 15px; background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 15px;">
                    <label
                        style="font-size: 0.7rem; color: var(--text-gray); margin-bottom: 8px; display: block; font-weight: 800; letter-spacing: 1px;">SEGURIDAD
                        DE CUENTA</label>
                    <button type="button" id="btn-admin-reset-pass" class="btn-glass"
                        style="width: 100%; border-color: #eab308; color: #eab308; display: flex; align-items: center; justify-content: center; gap: 10px;">
                        <i data-lucide="mail"></i> REESTABLECER CONTRASEÑA
                    </button>
                    <p style="font-size: 0.6rem; color: var(--text-gray); margin-top: 8px; text-align: center;">Se
                        enviará un email al socio para crear una nueva clave.</p>
                </div>
                <button type="submit" class="btn-primary">GUARDAR SOCIO 🥋</button>
            </form>
        </div>
    </div>
    <!-- Tournament Management Modal -->
    <div id="tourney-modal" class="overlay">
        <div class="modal-content glass">
            <div class="modal-header">
                <h3 id="tourney-modal-title">Nuevo Torneo</h3>
                <button class="btn-close-modal">×</button>
            </div>
            <form id="tourney-form">
                <input type="hidden" id="tourney-id">
                <div class="form-group">
                    <label>Nombre del Torneo</label>
                    <input type="text" id="tourney-name" placeholder="Ej: Open Santiago BJJ" required>
                </div>
                <div class="form-group">
                    <label>Ubicación / Lugar</label>
                    <input type="text" id="tourney-place" placeholder="Ej: Gimnasio Municipal" required>
                </div>
                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" id="tourney-date" required>
                </div>
                <button type="submit" class="btn-primary">GUARDAR TORNEO 🏆</button>
            </form>
        </div>
    </div>
</body>



</html>