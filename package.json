{
    "name": "amaru-fighter-project",
    "version": "1.0.0",
    "description": "Premium Martial Arts Landing Page & App",
    "main": "index.html",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node -e \"const fs=require('fs'),path=require('path');['dist/app/images','dist/app/styles'].forEach(d=>{try{fs.mkdirSync(d,{recursive:true})}catch(e){}});fs.copyFileSync('app/sw.js','dist/app/sw.js');fs.copyFileSync('app/manifest.json','dist/app/manifest.json');fs.copyFileSync('app/images/icon-192.png','dist/app/images/icon-192.png');\"",
        "preview": "vite preview",
        "deploy": "npm run build && gh-pages -d dist",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.99.3",
        "canvas-confetti": "^1.9.4",
        "chart.js": "^4.5.1",
        "lucide": "^1.14.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "serve": "^14.2.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.1",
        "vitest": "^4.1.5"
    },
    "type": "module"
}
